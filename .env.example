# Backend API (local or Render URL)
NEXT_PUBLIC_API_URL=http://localhost:4000

# UploadThing – paste token from dashboard (Settings → API Keys), no quotes
UPLOADTHING_TOKEN=

# Google Maps – map display and default trip images from locations
# Used by the browser for interactive maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional server-only key for trip preview static maps (/api/static-map).
# Prefer this in production so Maps Static API is not blocked by HTTP referrer
# restrictions on your Vercel domain. Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY=
